# Copy to .env.local and adjust. Never commit .env.local.

# SQLite file (default) — or a Turso/libSQL URL such as libsql://<db>.turso.io
DATABASE_URL=file:db/world-plate.db
# Only needed for remote libSQL/Turso databases
DATABASE_AUTH_TOKEN=

# Public site URL, used for canonical URLs, Open Graph and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Accounts (Firebase Authentication + Firestore). From Firebase console → Project settings → Your apps → Web app.
# These web keys are public by design (they end up in the browser); firestore.rules protects each account's data.
# Leave them empty and the site works without accounts (favorites stay in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Optional: Firebase App Check with reCAPTCHA v3 (site key only; the secret key goes in the Firebase console).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
