rules_version = '2';

// World Plate: each account has one document, users/{uid}, holding its name and saved recipe slugs.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "favorites", "createdAt", "updatedAt"])
        && (!("favorites" in request.resource.data)
            || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 300))
        && (!("name" in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
