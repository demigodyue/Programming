rules_version = '2';

// Sizzle Atlas: each account has one document, users/{uid}, holding its name, saved recipe slugs and star ratings.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// - Only the signed-in owner can read or write their own document; nothing else in the database is reachable.
// - Writes may only touch these fields, with these types and values (the site never writes anything else):
//     name       string, up to 60 characters
//     favorites  list of distinct recipe slugs from recipeSlugs() (so no junk or oversized entries)
//     ratings    map of recipe slug → 1, 2, 3, 4 or 5 stars
//     createdAt / updatedAt  the server's own timestamp (request.time), so nobody can backdate them
// recipeSlugs() is generated from the recipes by scripts/sync-recipe-slugs.ts (it runs before every build).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // RECIPE_SLUGS (generated by scripts/sync-recipe-slugs.ts)
      function recipeSlugs() {
        return [
          "aloo-samosa",
          "banh-mi",
          "bibimbap",
          "butter-chicken",
          "chicken-biryani",
          "chicken-chow-mein",
          "chicken-momo",
          "chilaquiles-rojos",
          "churros",
          "crepes",
          "croissants",
          "dal-bhat",
          "enchiladas-verdes",
          "falafel",
          "gazpacho",
          "goi-cuon",
          "guacamole",
          "hummus",
          "jhol-momo",
          "katsu-curry",
          "kimchi-jjigae",
          "kukhura-ko-masu",
          "kung-pao-chicken",
          "lasagne-bolognese",
          "maki-sushi",
          "mango-sticky-rice",
          "mapo-tofu",
          "margherita-pizza",
          "masala-dosa",
          "okonomiyaki",
          "pad-thai",
          "paella-marisco",
          "pho-bo",
          "ratatouille",
          "sel-roti",
          "shakshuka",
          "shoyu-ramen",
          "spaghetti-carbonara",
          "tacos-al-pastor",
          "thai-green-curry",
          "thukpa",
          "tiramisu",
          "tortilla-espanola",
          "tteokbokki",
          "xiaolongbao",
          "yangnyeom-chicken"
        ];
      }
      // END RECIPE_SLUGS

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validFields(data) {
        return data.keys().hasOnly(["name", "favorites", "ratings", "createdAt", "updatedAt"])
          && (!("name" in data) || (data.name is string && data.name.size() <= 60))
          && (!("favorites" in data) || (data.favorites is list
                && data.favorites.size() <= recipeSlugs().size()
                && data.favorites.toSet().size() == data.favorites.size()
                && data.favorites.hasOnly(recipeSlugs())))
          && (!("ratings" in data) || (data.ratings is map
                && data.ratings.keys().hasOnly(recipeSlugs())
                && data.ratings.values().hasOnly([1, 2, 3, 4, 5])))
          && (!("createdAt" in data) || data.createdAt == request.time || data.createdAt == resource.data.createdAt)
          && (!("updatedAt" in data) || data.updatedAt == request.time || data.updatedAt == resource.data.updatedAt);
      }

      allow read, delete: if isOwner();
      allow create: if isOwner() && validFields(request.resource.data);
      allow update: if isOwner() && validFields(request.resource.data);
    }
  }
}
